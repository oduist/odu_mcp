<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_odoo_mcp_access_list" model="ir.ui.view">
        <field name="name">odoo.mcp.access.list</field>
        <field name="model">odoo.mcp.access</field>
        <field name="arch" type="xml">
            <list decoration-muted="not active">
                <field name="active" widget="boolean_toggle"/>
                <field name="name"/>
                <field name="user_id"/>
                <field name="profile_id"/>
                <field name="last_used_at"/>
                <field name="request_count"/>
                <field name="failure_count"/>
            </list>
        </field>
    </record>

    <record id="view_odoo_mcp_access_form" model="ir.ui.view">
        <field name="name">odoo.mcp.access.form</field>
        <field name="model">odoo.mcp.access</field>
        <field name="arch" type="xml">
            <form>
                <sheet>
                    <div class="oe_title">
                        <label for="name"/>
                        <h1><field name="name"/></h1>
                    </div>
                    <group>
                        <group>
                            <field name="active"/>
                            <field name="user_id"/>
                            <field name="profile_id"/>
                        </group>
                        <group string="Usage">
                            <field name="last_used_at"/>
                            <field name="request_count"/>
                            <field name="failure_count"/>
                        </group>
                    </group>
                    <div class="alert alert-info" role="alert">
                        Users create and revoke MCP-only API keys in their own Odoo profile.
                        This record assigns the MCP security profile used by those keys.
                    </div>
                </sheet>
            </form>
        </field>
    </record>

    <record id="view_odoo_mcp_access_search" model="ir.ui.view">
        <field name="name">odoo.mcp.access.search</field>
        <field name="model">odoo.mcp.access</field>
        <field name="arch" type="xml">
            <search>
                <field name="name"/>
                <field name="user_id"/>
                <field name="profile_id"/>
                <filter name="inactive" string="Inactive" domain="[('active', '=', False)]"/>
                <group name="groupby">
                    <filter name="group_profile" string="Profile" context="{'group_by': 'profile_id'}"/>
                </group>
            </search>
        </field>
    </record>

    <record id="action_odoo_mcp_access" model="ir.actions.act_window">
        <field name="name">User Access</field>
        <field name="res_model">odoo.mcp.access</field>
        <field name="view_mode">list,form</field>
        <field name="search_view_id" ref="view_odoo_mcp_access_search"/>
    </record>
</odoo>
