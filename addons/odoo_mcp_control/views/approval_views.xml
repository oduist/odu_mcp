<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_odoo_mcp_approval_list" model="ir.ui.view">
        <field name="name">odoo.mcp.approval.list</field>
        <field name="model">odoo.mcp.approval</field>
        <field name="arch" type="xml">
            <list create="0" edit="0" delete="0"
                  decoration-warning="state == 'pending'"
                  decoration-success="state == 'executed'"
                  decoration-danger="state in ('rejected', 'failed', 'expired')">
                <field name="create_date"/>
                <field name="request_uid"/>
                <field name="state"/>
                <field name="risk_level"/>
                <field name="summary"/>
                <field name="credential_id"/>
                <field name="model_name"/>
                <field name="target_count"/>
                <field name="expires_at"/>
            </list>
        </field>
    </record>

    <record id="view_odoo_mcp_approval_form" model="ir.ui.view">
        <field name="name">odoo.mcp.approval.form</field>
        <field name="model">odoo.mcp.approval</field>
        <field name="arch" type="xml">
            <form create="0" edit="0" delete="0">
                <header>
                    <button name="action_approve"
                            type="object"
                            string="Approve"
                            class="btn-primary"
                            confirm="Approve this exact change plan?"
                            invisible="state != 'pending'"
                            groups="odoo_mcp_control.group_mcp_manager"/>
                    <button name="action_reject"
                            type="object"
                            string="Reject"
                            class="btn-secondary"
                            confirm="Reject this change plan?"
                            invisible="state not in ('pending', 'approved')"
                            groups="odoo_mcp_control.group_mcp_manager"/>
                    <field name="state" widget="statusbar"
                           statusbar_visible="pending,approved,executing,executed,rejected,expired,failed"/>
                </header>
                <sheet>
                    <div class="oe_title">
                        <h1><field name="summary"/></h1>
                    </div>
                    <group>
                        <group>
                            <field name="request_uid"/>
                            <field name="credential_id"/>
                            <field name="profile_id"/>
                            <field name="connector_user_id"/>
                            <field name="action"/>
                            <field name="model_name"/>
                        </group>
                        <group>
                            <field name="risk_level"/>
                            <field name="target_count"/>
                            <field name="expires_at"/>
                            <field name="approved_by"/>
                            <field name="approved_at"/>
                            <field name="executed_at"/>
                        </group>
                    </group>
                    <notebook>
                        <page string="Redacted Diff">
                            <field name="diff_json" widget="text"/>
                        </page>
                        <page string="Result">
                            <field name="result_json" widget="text"/>
                            <field name="error_message"/>
                        </page>
                        <page string="Integrity" groups="odoo_mcp_control.group_mcp_manager">
                            <field name="payload_hash"/>
                            <field name="idempotency_key"/>
                        </page>
                    </notebook>
                </sheet>
            </form>
        </field>
    </record>

    <record id="view_odoo_mcp_approval_search" model="ir.ui.view">
        <field name="name">odoo.mcp.approval.search</field>
        <field name="model">odoo.mcp.approval</field>
        <field name="arch" type="xml">
            <search>
                <field name="request_uid"/>
                <field name="summary"/>
                <field name="credential_id"/>
                <field name="model_name"/>
                <filter name="pending" string="Pending" domain="[('state', '=', 'pending')]"/>
                <filter name="failed" string="Failed" domain="[('state', '=', 'failed')]"/>
                <group name="groupby">
                    <filter name="group_state" string="State" context="{'group_by': 'state'}"/>
                    <filter name="group_risk" string="Risk" context="{'group_by': 'risk_level'}"/>
                    <filter name="group_model" string="Model" context="{'group_by': 'model_name'}"/>
                </group>
            </search>
        </field>
    </record>

    <record id="action_odoo_mcp_approvals" model="ir.actions.act_window">
        <field name="name">Approval Inbox</field>
        <field name="res_model">odoo.mcp.approval</field>
        <field name="view_mode">list,form</field>
        <field name="search_view_id" ref="view_odoo_mcp_approval_search"/>
        <field name="context">{'search_default_pending': 1}</field>
    </record>
</odoo>
