<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_odoo_mcp_credential_list" model="ir.ui.view">
        <field name="name">odoo.mcp.credential.list</field>
        <field name="model">odoo.mcp.credential</field>
        <field name="arch" type="xml">
            <list decoration-muted="not active" decoration-danger="revoked_at">
                <field name="active" widget="boolean_toggle"/>
                <field name="name"/>
                <field name="profile_id"/>
                <field name="user_id"/>
                <field name="secret_hint"/>
                <field name="expires_at"/>
                <field name="last_used_at"/>
                <field name="request_count"/>
                <field name="failure_count"/>
            </list>
        </field>
    </record>

    <record id="view_odoo_mcp_credential_form" model="ir.ui.view">
        <field name="name">odoo.mcp.credential.form</field>
        <field name="model">odoo.mcp.credential</field>
        <field name="arch" type="xml">
            <form>
                <header>
                    <button name="action_generate_secret"
                            type="object"
                            string="Issue / Rotate Secret"
                            class="btn-primary"
                            groups="odoo_mcp_control.group_mcp_manager"/>
                    <button name="action_revoke"
                            type="object"
                            string="Revoke"
                            class="btn-secondary"
                            confirm="Revoke this connector credential?"
                            invisible="not active"
                            groups="odoo_mcp_control.group_mcp_manager"/>
                </header>
                <sheet>
                    <widget name="web_ribbon" title="Revoked" bg_color="text-bg-danger" invisible="not revoked_at"/>
                    <div class="oe_title">
                        <label for="name"/>
                        <h1><field name="name"/></h1>
                    </div>
                    <group>
                        <group>
                            <field name="active"/>
                            <field name="profile_id"/>
                            <field name="user_id"/>
                            <field name="expires_at"/>
                            <field name="allowed_ip_networks"
                                   placeholder="10.0.0.0/8&#10;2001:db8::/32"/>
                        </group>
                        <group string="Usage">
                            <field name="secret_hint"/>
                            <field name="last_used_at"/>
                            <field name="request_count"/>
                            <field name="failure_count"/>
                            <field name="revoked_at"/>
                        </group>
                    </group>
                    <div class="alert alert-warning" role="alert">
                        The connector secret is displayed only once. Store it in a secret manager.
                    </div>
                </sheet>
            </form>
        </field>
    </record>

    <record id="view_odoo_mcp_credential_search" model="ir.ui.view">
        <field name="name">odoo.mcp.credential.search</field>
        <field name="model">odoo.mcp.credential</field>
        <field name="arch" type="xml">
            <search>
                <field name="name"/>
                <field name="profile_id"/>
                <field name="user_id"/>
                <filter name="active" string="Active" domain="[('active', '=', True)]"/>
                <filter name="revoked" string="Revoked" domain="[('revoked_at', '!=', False)]"/>
                <group name="groupby">
                    <filter name="group_profile" string="Profile" context="{'group_by': 'profile_id'}"/>
                    <filter name="group_user" string="User" context="{'group_by': 'user_id'}"/>
                </group>
            </search>
        </field>
    </record>

    <record id="action_odoo_mcp_credentials" model="ir.actions.act_window">
        <field name="name">Connector Credentials</field>
        <field name="res_model">odoo.mcp.credential</field>
        <field name="view_mode">list,form</field>
        <field name="search_view_id" ref="view_odoo_mcp_credential_search"/>
    </record>
</odoo>
