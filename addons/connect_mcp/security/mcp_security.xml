<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="module_category_connect_mcp" model="ir.module.category">
        <field name="name">Connect MCP</field>
        <field name="sequence">90</field>
        <field name="parent_id" ref="base.module_category_administration"/>
    </record>

    <record id="group_mcp_auditor" model="res.groups">
        <field name="name">Auditor</field>
        <field name="category_id" ref="module_category_connect_mcp"/>
        <field name="implied_ids" eval="[(4, ref('base.group_user'))]"/>
        <field name="comment">Can inspect MCP profiles, approvals, user access assignments, and immutable audit records.</field>
    </record>

    <record id="group_mcp_manager" model="res.groups">
        <field name="name">Administrator</field>
        <field name="category_id" ref="module_category_connect_mcp"/>
        <field name="implied_ids" eval="[(4, ref('connect_mcp.group_mcp_auditor'))]"/>
        <field name="users" eval="[(4, ref('base.user_root')), (4, ref('base.user_admin'))]"/>
        <field name="comment">Can configure MCP policies, assign user access, and approve change plans.</field>
    </record>
</odoo>
