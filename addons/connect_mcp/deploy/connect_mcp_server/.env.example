CONNECT_MCP_ODOO_URL=http://127.0.0.1:8069
# Optional when the reverse proxy routes WebSockets to a separate evented upstream.
# CONNECT_MCP_EVENTS_URL=ws://127.0.0.1:8072/connect_mcp/v1/events
CONNECT_MCP_HOST=127.0.0.1
CONNECT_MCP_PORT=8000
CONNECT_MCP_MCP_PATH=/mcp
CONNECT_MCP_REQUEST_TIMEOUT_SECONDS=30
CONNECT_MCP_VERIFY_TLS=true
CONNECT_MCP_MAX_RESPONSE_BYTES=10485760
CONNECT_MCP_TOOL_GROUPS=core
CONNECT_MCP_LOG_LEVEL=INFO
CONNECT_MCP_LOG_FORMAT=json
CONNECT_MCP_IDENTITY_CACHE_SECONDS=10
CONNECT_MCP_USER_LOCK_TIMEOUT_SECONDS=5
CONNECT_MCP_RETRY_ATTEMPTS=3
CONNECT_MCP_CIRCUIT_FAILURE_THRESHOLD=5
CONNECT_MCP_CIRCUIT_RESET_SECONDS=30
CONNECT_MCP_EVENTS_ENABLED=true
CONNECT_MCP_EVENT_REFRESH_SECONDS=240
