<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_connect_mcp_audit_list" model="ir.ui.view">
        <field name="name">connect.mcp.audit.log.list</field>
        <field name="model">connect.mcp.audit.log</field>
        <field name="arch" type="xml">
            <list create="0" edit="0" delete="0"
                  decoration-success="outcome == 'success'"
                  decoration-warning="outcome == 'denied'"
                  decoration-danger="outcome == 'error'">
                <field name="create_date"/>
                <field name="request_id"/>
                <field name="outcome"/>
                <field name="status_code"/>
                <field name="operation"/>
                <field name="model_name"/>
                <field name="access_id"/>
                <field name="user_id"/>
                <field name="duration_ms"/>
                <field name="error_code"/>
            </list>
        </field>
    </record>

    <record id="view_connect_mcp_audit_form" model="ir.ui.view">
        <field name="name">connect.mcp.audit.log.form</field>
        <field name="model">connect.mcp.audit.log</field>
        <field name="arch" type="xml">
            <form create="0" edit="0" delete="0">
                <sheet>
                    <div class="oe_title">
                        <h1><field name="request_id"/></h1>
                    </div>
                    <group>
                        <group>
                            <field name="create_date"/>
                            <field name="access_id"/>
                            <field name="profile_id"/>
                            <field name="user_id"/>
                            <field name="approval_id"/>
                            <field name="remote_ip"/>
                        </group>
                        <group>
                            <field name="outcome"/>
                            <field name="status_code"/>
                            <field name="operation"/>
                            <field name="model_name"/>
                            <field name="duration_ms"/>
                            <field name="error_code"/>
                            <field name="error_class"/>
                        </group>
                    </group>
                    <group string="Redacted Request Metadata">
                        <field name="input_hash"/>
                        <field name="input_summary"/>
                        <field name="target_ids_json"/>
                        <field name="user_agent"/>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <record id="view_connect_mcp_audit_search" model="ir.ui.view">
        <field name="name">connect.mcp.audit.log.search</field>
        <field name="model">connect.mcp.audit.log</field>
        <field name="arch" type="xml">
            <search>
                <field name="request_id"/>
                <field name="operation"/>
                <field name="model_name"/>
                <field name="access_id"/>
                <field name="error_code"/>
                <filter name="failed" string="Errors" domain="[('outcome', '=', 'error')]"/>
                <filter name="denied" string="Denied" domain="[('outcome', '=', 'denied')]"/>
                <group name="groupby">
                    <filter name="group_outcome" string="Outcome" context="{'group_by': 'outcome'}"/>
                    <filter name="group_operation" string="Operation" context="{'group_by': 'operation'}"/>
                    <filter name="group_model" string="Model" context="{'group_by': 'model_name'}"/>
                    <filter name="group_day" string="Day" context="{'group_by': 'create_date:day'}"/>
                </group>
            </search>
        </field>
    </record>

    <record id="action_connect_mcp_audit" model="ir.actions.act_window">
        <field name="name">Audit Log</field>
        <field name="res_model">connect.mcp.audit.log</field>
        <field name="view_mode">list,form</field>
        <field name="search_view_id" ref="view_connect_mcp_audit_search"/>
    </record>
</odoo>
