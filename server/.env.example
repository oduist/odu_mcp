ODOO_MCP_ODOO_URL=http://127.0.0.1:8069
# ODOO_MCP_PUBLIC_URL=https://mcp.example.com
ODOO_MCP_HOST=127.0.0.1
ODOO_MCP_PORT=8000
ODOO_MCP_MCP_PATH=/mcp
ODOO_MCP_REQUEST_TIMEOUT_SECONDS=30
ODOO_MCP_VERIFY_TLS=true
ODOO_MCP_MAX_RESPONSE_BYTES=10485760
ODOO_MCP_TOOL_GROUPS=core
ODOO_MCP_LOG_LEVEL=INFO
ODOO_MCP_LOG_FORMAT=json
ODOO_MCP_IDENTITY_CACHE_SECONDS=10
ODOO_MCP_USER_LOCK_TIMEOUT_SECONDS=5
ODOO_MCP_RETRY_ATTEMPTS=3
ODOO_MCP_CIRCUIT_FAILURE_THRESHOLD=5
ODOO_MCP_CIRCUIT_RESET_SECONDS=30
ODOO_MCP_EVENTS_ENABLED=true
ODOO_MCP_EVENT_REFRESH_SECONDS=240
