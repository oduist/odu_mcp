ODOO_MCP_ODOO_URL=http://127.0.0.1:8069
ODOO_MCP_CONNECTOR_TOKEN=omcp_replace_me
ODOO_MCP_TRANSPORT=stdio
ODOO_MCP_HOST=127.0.0.1
ODOO_MCP_PORT=8000
ODOO_MCP_MCP_PATH=/mcp
ODOO_MCP_REQUEST_TIMEOUT_SECONDS=30
ODOO_MCP_VERIFY_TLS=true
ODOO_MCP_MAX_RESPONSE_BYTES=10485760
ODOO_MCP_TOOL_GROUPS=core
ODOO_MCP_LOG_LEVEL=INFO
ODOO_MCP_LOG_FORMAT=json
ODOO_MCP_AUTH_MODE=none
